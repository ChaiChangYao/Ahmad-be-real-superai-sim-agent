WEB_PORT=3000
API_PORT=8000
# Local dev: npm run dev starts web + API together
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Production (Vercel): set to hosted Python API, e.g. https://api.yourdomain.com

# Vercel AI Gateway — random project names on My Projects entry (apps/web/.env.local)
# AI_GATEWAY_API_KEY=

# Optional LLM polish (backend apps/api/.env.local — not required for agentic workflow)
# ENABLE_LLM_ASSISTANT=0
# ENABLE_LLM_REPORTER=0
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openai/gpt-4o-mini
