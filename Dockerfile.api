FROM python:3.11-slim-bookworm

WORKDIR /app/apps/api

ENV PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    PYTHONIOENCODING=utf-8 \
    MPLBACKEND=Agg \
    BUILDABLES_DISABLE_NATIVE_PLOTS=1 \
    BUILDABLES_EXECUTION_BACKEND=local \
    GENESIS_WORLD_ROOT=/app/genesis-world \
    SIM_DATA_ROOT=sim-data \
    API_HOST=0.0.0.0 \
    API_PORT=8000

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        ffmpeg \
        git \
        libegl1 \
        libgl1 \
        libglib2.0-0 \
        libglvnd0 \
        libgomp1 \
        libglut3.12 \
        libglu1-mesa \
        libsm6 \
        libx11-6 \
        libxext6 \
        libxrender1 \
        mesa-utils \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /app/apps/api/requirements.txt
RUN pip install --no-cache-dir -U "pip>=24.0" "setuptools>=77"
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.7.1
RUN pip install --no-cache-dir -r /app/apps/api/requirements.txt
RUN pip install --no-cache-dir --force-reinstall "networkx==3.6.1"
RUN pip install --no-cache-dir --force-reinstall --no-deps "scikit-image==0.25.2"
RUN pip install --no-cache-dir "lazy-loader==0.4"
RUN git clone --depth 1 https://github.com/Genesis-Embodied-AI/Genesis.git /app/genesis-world

COPY apps/api /app/apps/api
COPY packages /app/packages
COPY sim-data/active_project.json /app/sim-data/active_project.json
COPY sim-data/component-profiles /app/sim-data/component-profiles
COPY sim-data/material-profiles /app/sim-data/material-profiles
COPY sim-data/projects/default-robot-dog /app/sim-data/projects/default-robot-dog
COPY sim-data/projects/genesis-workbench /app/sim-data/projects/genesis-workbench

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
