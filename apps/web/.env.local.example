# Local dev (npm run dev starts web + API). Copy to .env.local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Agentic assistant (defaults to API base above)
# NEXT_PUBLIC_AGENTIC_API_URL=http://127.0.0.1:8000/api/agentic

# Optional feature flags (Part 2 — cosmetic until Part 6)
# NEXT_PUBLIC_ENABLE_LLM_ASSISTANT=false
# NEXT_PUBLIC_ENABLE_COPILOTKIT=false

# Production (Vercel): deploy Python API via render.yaml, then set on Vercel:
# API_UPSTREAM_URL=https://your-service.onrender.com
# Frontend proxies /backend/* to that URL automatically.
# Do not start uvicorn on Vercel — deploy apps/web only.
